# 资源目录路径（宿主机上的资源存放位置，必填）
# NAS 部署示例：NAS_RESOURCE_PATH=/vol2/1000/Software
NAS_RESOURCE_PATH=./data/resources

# 数据持久化路径
DATA_PATH=./data

# 上传文件路径
UPLOAD_PATH=./data/uploads

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# 前端配置
FRONTEND_PORT=5173

# 可选：对外访问地址（部署到局域网/NAS 时填写，浏览器和 CORS 会用）
# FRONTEND_URL=http://192.168.3.222:5173
# VITE_API_URL=http://192.168.3.222:8787/api/v1

# 可选：构建代理与 pip 镜像源（国内网络建议填镜像源）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
